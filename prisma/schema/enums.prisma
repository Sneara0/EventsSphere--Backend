
enum Role {
  SUPER_ADMIN
  ADMIN
  ORGANIZER
  USER
  PARTICIPANT
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BookingStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum PaymentStatus {
  PENDING   // ✅ এটি যোগ করুন
  UNPAID
  PAID
  REFUNDED
}
enum EventStatus {
  UPCOMING    // টিকিট বিক্রির জন্য উন্মুক্ত
  ON_BOARDING // চেক-ইন বা বোর্ডিং শুরু হয়েছে (Ongoing এর বদলে)
  DEPARTED    // বিমান ছেড়ে গেছে
  ARRIVED     // গন্তব্যে পৌঁছেছে (Completed এর বদলে)
  CANCELLED   // ফ্লাইট বাতিল হয়েছে
  DELAYED     // ফ্লাইট দেরি হয়েছে (এটি খুব গুরুত্বপূর্ণ)
}





