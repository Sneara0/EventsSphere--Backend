
model Review {
  id        String   @id @default(uuid())
  rating    Int      @default(5)
  comment   String
  userId    String
  eventId   String
  user      User     @relation(fields: [userId], references: [id])
  event     Event    @relation(fields: [eventId], references: [id])
  createdAt DateTime @default(now())

  @@map("reviews")
}
