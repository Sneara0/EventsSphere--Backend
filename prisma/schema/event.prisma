model Event {
  id              String    @id @default(uuid())
  title           String
  description     String
  location        String
  date            DateTime
  flightTime      DateTime?
  airline         String?
  travelGuideline String?
  price           Float
  banner          String
  category        String
  isVerified      Boolean   @default(false)

  // এটি আপনার অর্গানাইজার টেবিলের সাথে কানেক্ট করবে
  organizerId     String
  organizer       Organizer @relation(fields: [organizerId], references: [id])

  bookings        Booking[]
  reviews         Review[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("events")
  @@index([category])
  @@index([location])
}