model Event {
  id              String   @id @default(cuid())
  title           String
  description     String
  category        String   // e.g., Concert, Workshop, Seminar
   dateTime        DateTime
  time            String
  venue           String   // Location
  thumbnail       String?  // Cloudinary Image URL
  ticketPrice     Float    @default(0)
  totalSeats      Int
  availableSeats  Int
  status          EventStatus @default(UPCOMING)
  isDeleted       Boolean  @default(false)

  // Relations
  organizerId     String
  organizer       Organizer @relation(fields: [organizerId], references: [id])
  
  bookings        Booking[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  reviews Review[]
  coupons     Coupon[]

  @@map("events")
}