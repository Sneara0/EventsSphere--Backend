{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "node",
    "target": "es2023",
    "rootDir": "./",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "6.0",
    
    /* কাস্টম পাথ সেটআপ */
    "baseUrl": ".",
    "paths": {
      "@prisma/client": ["./src/generated/prisma"]
    }
  },
  "include": ["src", "prisma.config.ts"],
  "exclude": ["node_modules", "dist"]
}